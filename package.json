{
  "name": "@webship.co/workspace-bbpress",
  "version": "1.0.0",
  "description": "bbPress for Webship Workspace, on top of its WordPress plugin: the builder (`cmd-bbpress-project.sh`) in every sites folder, a site with forums set up for testing, the default accounts (one per forum role), the sample content, the forums' tool (`cmd-tools-bbpress-forums.sh`), the bbPress step pack wired into the testing setup next to the WordPress one, and its AI items in their folders: two agents, a skill, a command and two prompts.",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "license": "ISC",
  "engines": {
    "node": ">=24"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/webship/workspace-bbpress.git"
  },
  "files": [
    "dist/src",
    "ai",
    "commands",
    "features",
    "scripts",
    "testing",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "workspacePlugin": {
    "name": "bbpress",
    "label": "bbPress",
    "needs": [
      [
        "dev",
        "test",
        "sandboxes",
        "demos"
      ],
      "wordpress",
      "ai-agents",
      "ai-skills",
      "ai-commands",
      "ai-prompts"
    ],
    "commands": {
      "types": [
        "sites"
      ],
      "workspaces": [
        "dev",
        "test",
        "sandboxes",
        "demos"
      ],
      "files": [
        "commands/cmd-bbpress-project.sh",
        "commands/cmd-tools-bbpress-forums.sh"
      ]
    },
    "scripts": {
      "functions": [
        "scripts/functions/fun-bbpress.sh"
      ],
      "args": [
        "scripts/args/arg-bbpress.sh",
        "scripts/args/arg-bbpress-forums.sh"
      ],
      "machine": [
        "testing/forums.feature",
        "scripts/forum-site.php"
      ]
    },
    "ai": {
      "agents": [
        "ai/agents/bbpress-site-builder.md",
        "ai/agents/bbpress-tester.md"
      ],
      "skills": [
        "ai/skills/bbpress-scenarios"
      ],
      "commands": [
        "ai/commands/bbpress-test.md"
      ],
      "prompts": [
        "ai/prompts/bbpress-build-and-test.md",
        "ai/prompts/bbpress-moderation-round.md"
      ]
    },
    "features": [
      "features/bbpress.feature"
    ]
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@webship.co/workspace-plugin-api": "^1.0.11",
    "typescript": "^5.9.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
